{
  "functions": {
    "api/shot.js": {
      "maxDuration": 60
    },
    "api/search.js": {
      "maxDuration": 30,
      "includeFiles": "search-data/**"
    },
    "api/susy/search.js": {
      "maxDuration": 30,
      "includeFiles": "search-data/susy.json.gz"
    },
    "api/susy/shot.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/nomi/search", "destination": "/api/search" },
    { "source": "/api/nomi/shot", "destination": "/api/shot" }
  ]
}
